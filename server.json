{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.aixtral/toolars",
  "title": "Toolars",
  "description": "Local-first dev utilities: hash, base64, JWT, UUID, cron, URL codec. No network or telemetry.",
  "repository": {
    "url": "https://github.com/aixtral/toolars-open",
    "source": "github"
  },
  "websiteUrl": "https://toolars.com",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@toolars/cli",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "-y"
        },
        {
          "type": "positional",
          "value": "-p"
        },
        {
          "type": "positional",
          "value": "@toolars/cli"
        },
        {
          "type": "positional",
          "value": "toolars-mcp"
        }
      ]
    }
  ]
}
