{
  "name": "@toolars/local-tools",
  "version": "0.1.0-experimental.1",
  "private": true,
  "description": "Toolars local-tools experiment: a local stdio CLI and MCP server for strict JSON formatting and SHA-256 hashing. Zero runtime dependencies, no network access, no telemetry.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "exports": "./src/core.mjs",
  "bin": {
    "toolars-local": "./src/cli.mjs",
    "toolars-mcp": "./src/mcp.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "toolars",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "stdio",
    "local-first",
    "privacy",
    "json",
    "json-format",
    "sha256",
    "hash"
  ],
  "homepage": "https://github.com/aixtral/toolars-open/tree/main/packages/local-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aixtral/toolars-open.git",
    "directory": "packages/local-tools"
  },
  "bugs": {
    "url": "https://github.com/aixtral/toolars-open/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6"
  }
}
